<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(DefaultClassLibTargetFrameworks)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>RocksDb.Net</AssemblyName>
    <RootNamespace>RocksDbNet</RootNamespace>
    <IsPackable>true</IsPackable>

    <!--
      Turns on the trim and AOT analyzers, and implies IsTrimmable on net8.0 and
      later. The point is to have the build report what stands between this
      library and a working PublishAot rather than leaving the question open:
      an embedded key-value store is a natural dependency for exactly the
      deployments that care, and those users will try it.

      Per target framework, and this library multi-targets, so all three are
      analysed.
    -->
    <IsAotCompatible>true</IsAotCompatible>

    <!--
      Fails `dotnet pack` on a change that would break source or binary
      compatibility with the baseline in Directory.Build.props, across every
      target framework. That turns the versioning promise in the changelog
      into something the build checks. Only while the baseline wraps the same
      RocksDb version; see the comment on the baseline for why.
    -->
    <EnablePackageValidation Condition="$(PackageValidationBaselineVersion.StartsWith('$(RocksDbVersion).'))">true</EnablePackageValidation>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Suppress CS1591: library is documented on public API surface; Dispose/ToString are self-evident -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Zoltan Csizmadia</Authors>
    <Owners>Zoltan Csizmadia</Owners>
    <PackageId>RocksDb.Net</PackageId>
    <PackageVersion>$(Version)</PackageVersion>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageTags>rocksdb;leveldb;embedded;database;key-value;cache</PackageTags>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/zcsizmadia/RocksDb.Net</RepositoryUrl>
    <PackageProjectUrl>https://github.com/zcsizmadia/RocksDb.Net</PackageProjectUrl>
    <PackageIcon>logo-128.png</PackageIcon>
    <!-- nuget.org renders this as plain text, so no markup: a bare URL autolinks. -->
    <PackageReleaseNotes>https://github.com/zcsizmadia/RocksDb.Net/releases</PackageReleaseNotes>
    <Description>C# wrapper for the RocksDb embedded key-value store</Description>
    <Copyright>Copyright © 2026 Zoltan Csizmadia</Copyright>
    <IsPackable>true</IsPackable>

    <!--
      A symbols package beside the main one, so stepping into the library from
      a consuming app shows its source rather than a decompilation. Source Link
      ships with the SDK, so the PDBs point at this repository's sources at the
      commit that was built, and EmbedUntrackedSources covers the generated
      files Source Link cannot map.
    -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../LICENSE" Pack="true" PackagePath="" />
    <None Include="../README.md" Pack="true" PackagePath="" />
    <None Include="../logo-128.png" Pack="true" PackagePath="" />
    <!-- RocksDB's attribution travels with the package, not just the repo. -->
    <None Include="../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="" />

    <!--
      Apache 2.0 section 4(a) requires a copy of the licence to travel with the
      work, not a link to it. The generated bindings are derived from RocksDb's
      C header and this project says so, so the text is packed rather than
      merely referenced.
    -->
    <None Include="../licenses/**" Pack="true" PackagePath="licenses/" />
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="RocksDb.Net.Runtimes" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="RocksDbNet.Native" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RocksDb.Net.Tests" />
  </ItemGroup>

</Project>
