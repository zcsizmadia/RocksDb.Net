<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.4" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <!--
      The lowest version that serves every target framework, deliberately. A
      library sets the floor for everyone who installs it, and an application
      on .NET 8 should not be pulled onto a newer Microsoft.Extensions line
      because of a database wrapper. Dependabot leaves its major version alone.
    -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
    <!-- The observability sample's console output only; nothing the package depends on. -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="8.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <!--
      Bounded, not open-ended. The P/Invoke declarations in NativeMethods.g.cs
      are generated from exactly this RocksDb version's c.h, so a runtimes
      package built from a different RocksDb version can disagree with them
      about the native ABI. That disagreement would not be caught at build or
      load time; it would be wrong argument marshalling at the first call.

      The range admits revisions of this same RocksDb version, which is what a
      packaging or rebuild fix ships as, and excludes the next one, which needs
      regenerated bindings and a new release of this package.

      The floor is revision 2, not 1. Revision 1 shipped the native binaries
      with no attribution for the third-party libraries alongside them, and
      those licences ask for their notices to travel with the binaries. Since
      revision 2 is what carries them, anyone installing this package should
      get it rather than being free to resolve the revision that does not.
    -->
    <PackageVersion Include="RocksDb.Net.Runtimes" Version="[$(RocksDbVersion).2, $(RocksDbVersionNextPatch))" />
  </ItemGroup>
</Project>