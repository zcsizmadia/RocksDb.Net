<Project>
  <PropertyGroup>
    <DefaultTargetFramework>net10.0</DefaultTargetFramework>
    <DefaultClassLibTargetFrameworks>net8.0;net9.0;net10.0</DefaultClassLibTargetFrameworks>
  </PropertyGroup>

  <PropertyGroup>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <RocksDbVersion>11.8.1</RocksDbVersion>

    <!--
      The package version is <RocksDbVersion>.<Revision>, so 11.8.1.2 wraps
      RocksDb 11.8.1. Bump this for a release that does not change the native
      version; breaking changes wait for a RocksDbVersion bump, because a
      revision alone must not break source or binary compatibility. See
      CHANGELOG.md under Versioning.
    -->
    <Revision>2</Revision>

    <!--
      VersionPrefix rather than Version, so that a prerelease can be built by
      supplying VersionSuffix. Setting Version outright makes the SDK ignore
      VersionSuffix entirely, which meant there was no way to produce a
      preview package at all: the release workflow compares the tag against
      this property, so a `-preview.1` tag failed the version gate with a
      mismatch rather than publishing anything.

      With a prefix, `-p:VersionSuffix=preview.1` yields 11.8.1.2-preview.1,
      and an empty suffix yields the plain version exactly as before.
    -->
    <VersionPrefix>$(RocksDbVersion).$(Revision)</VersionPrefix>

    <!--
      The next RocksDb patch version, used to put an exclusive upper bound on
      the native runtimes dependency. Derived rather than written out, so a
      RocksDbVersion bump cannot leave a stale bound behind.
    -->
    <RocksDbVersionNextPatch>$([System.Version]::Parse('$(RocksDbVersion)').Major).$([System.Version]::Parse('$(RocksDbVersion)').Minor).$([MSBuild]::Add($([System.Version]::Parse('$(RocksDbVersion)').Build), 1))</RocksDbVersionNextPatch>
    <PackageVersion>$(Version)</PackageVersion>
    <Authors>Zoltan Csizmadia</Authors>
  </PropertyGroup>
</Project>