<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      One framework, not three. This tests a build-time tool that only ever runs
      on the SDK's own runtime, so multi-targeting it would triple the run for
      no coverage of anything.
    -->
    <TargetFramework>$(DefaultTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NativeMethodsGenerator\NativeMethodsGenerator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="NativeMethodsGenerator" />
  </ItemGroup>

</Project>
