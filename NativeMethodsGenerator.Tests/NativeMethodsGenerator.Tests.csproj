<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      One framework, not three. This tests a build-time tool that only ever runs
      on the SDK's own runtime, so multi-targeting it would triple the run for
      no coverage of anything.
    -->
    <TargetFramework>$(DefaultTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!--
      xunit v3 runs through VSTest here, not Microsoft.Testing.Platform. v3
      builds a testing-platform application by default, and on the .NET 10 SDK
      dotnet test refuses to drive one through VSTest. Moving to the platform
      would change the syntax of every flag the CI test step depends on: the
      crash and hang blame, coverage collection, the results directory and the
      32-bit run. That is a migration of its own; this keeps those working
      unchanged, through xunit.runner.visualstudio.
    -->
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NativeMethodsGenerator\NativeMethodsGenerator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="NativeMethodsGenerator" />
  </ItemGroup>

</Project>
