{
  // Rules for the Markdown in this repository: the README, the changelog and
  // the DocFX guides.
  "default": true,

  // The README wraps prose at natural sentence boundaries rather than a fixed
  // column, and the changelog has long table cells. Enforcing a line length
  // would mean reflowing prose for no reader benefit.
  "MD013": false,

  // DocFX articles and the changelog legitimately repeat headings such as
  // "Breaking changes" under different releases.
  "MD024": { "siblings_only": true },

  // MD033 (no inline HTML) is deliberately left ON. The README ships inside the
  // NuGet package, and nuget.org escapes raw HTML and renders it as visible
  // text rather than dropping it. A centred <div> here once put literal markup
  // at the top of the package page and hid the logo, so the rule guards
  // against reintroducing it.

  // The README opens with the logo image, so its first line is not a heading.
  "MD041": false,

  // Bare URLs are already avoided, but DocFX cross-reference syntax (xref:)
  // is not a URL the linter understands.
  "MD034": false
}
