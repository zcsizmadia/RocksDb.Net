<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(DefaultClassLibTargetFrameworks)</TargetFrameworks>

    <!--
      Stated here although xunit.v3 sets it too. The package sets it from its
      own props, and those are only imported once restore has run, so restore
      itself sees a Library and fetches no app host pack. For x64 that goes
      unnoticed, because the SDK ships that app host in the box; the 32-bit CI
      leg (`dotnet test -a x86`) then fails on a clean checkout, unable to copy
      a win-x86 apphost.exe that restore never downloaded.
    -->
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!--
      xunit v3 runs through VSTest here, not Microsoft.Testing.Platform. v3
      builds a testing-platform application by default, and on the .NET 10 SDK
      dotnet test refuses to drive one through VSTest. Moving to the platform
      would change the syntax of every flag the CI test step depends on: the
      crash and hang blame, coverage collection, the results directory and the
      32-bit run. That is a migration of its own; this keeps those working
      unchanged, through xunit.runner.visualstudio.
    -->
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>RocksDbNet.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RocksDb.Net\RocksDb.Net.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    The pinned native version, so a test can check the generated files were
    regenerated after it changed. Passed in from the build rather than read
    from Directory.Build.props at runtime, so the test compares against the
    same value the build itself used.
  -->
  <ItemGroup>
    <AssemblyMetadata Include="RocksDbVersion" Value="$(RocksDbVersion)" />
  </ItemGroup>

</Project>