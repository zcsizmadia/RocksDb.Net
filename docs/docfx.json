{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "files": [ "RocksDb.Net/RocksDb.Net.csproj" ],
          "src": ".."
        }
      ],
      "dest": "api",
      "properties": {
        "TargetFramework": "net10.0",
        "Configuration": "Release"
      },
      "filter": "filterConfig.yml",
      "outputFormat": "mref",
      "allowCompilationErrors": false
    }
  ],
  "build": {
    "content": [
      {
        "files": [ "api/**.yml", "api/index.md" ]
      },
      {
        "files": [ "*.md", "toc.yml", "articles/**.md", "articles/**/toc.yml" ]
      }
    ],
    "resource": [
      {
        "files": [ "logo-128.png" ],
        "src": ".."
      }
    ],
    "output": "_site",
    "template": [ "default", "modern" ],
    "globalMetadata": {
      "_appName": "RocksDb.Net",
      "_appTitle": "RocksDb.Net",
      "_appLogoPath": "logo-128.png",
      "_appFaviconPath": "logo-128.png",
      "_enableSearch": true,
      "_disableContribution": false,
      "_gitContribute": {
        "repo": "https://github.com/zcsizmadia/RocksDb.Net",
        "branch": "main"
      }
    },
    "sitemap": {
      "baseUrl": "https://zcsizmadia.github.io/RocksDb.Net/"
    }
  }
}
